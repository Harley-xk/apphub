# apphub 后端 systemd 服务单元（安装到 /etc/systemd/system/apphub.service，见 docs/指南/发布包打包与部署指南.md）
# 安装：cp deploy/apphub.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable apphub
[Unit]
Description=apphub 后端服务（NestJS）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/apphub/server
# 外置运行配置（DB / JWT / 签名密钥等），与发布包解耦
EnvironmentFile=/opt/apphub/server.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=3
# 如需收紧权限可换专用运行用户（须对 /opt/apphub 有读权限、对日志目录有写权限）
# User=apphub

[Install]
WantedBy=multi-user.target
