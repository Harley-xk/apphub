# n-1 服务器全局 nginx 站点配置示例
# 拷入 /etc/nginx/conf.d/n1.conf（或 sites-enabled/ 后按发行版习惯软链），改 server_name 后 nginx -t && nginx -s reload
# HTTPS：在 server 块按需补 443 监听与证书；CSP / HSTS 等安全头由本层统一注入（见 docs/架构设计.md）
server {
    listen 80;
    # 修改为实际域名（或服务器 IP）
    server_name your-domain.example.com;

    # 与镜像内 nginx（docker/nginx.conf）保持一致的上传限制
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
