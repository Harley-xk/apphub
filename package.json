{
  "name": "apphub",
  "version": "0.1.0",
  "private": true,
  "description": "apphub —— 应用管理平台（多应用更新检测 / 统一认证授权 / 订阅管理），基于企业级全栈底座（Monorepo）",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter server run dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter server run test && pnpm --filter web run test",
    "test:e2e": "pnpm --filter server run test:e2e",
    "test:e2e:web": "pnpm --filter e2e run test",
    "check": "pnpm lint && pnpm type-check && pnpm test && pnpm test:e2e",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "lefthook": "^2.1.12"
  }
}
