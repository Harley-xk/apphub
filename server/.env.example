# 后端环境变量模板（使用方式：copy .env.example .env，含密钥的 .env 不入库）

# 服务端口
PORT=3000

# 数据库连接配置：默认与首选 PostgreSQL（独立部署，按实际环境填写）。
# 切换数据库：修改 DB_TYPE 与连接参数并安装对应驱动包，详见 docs/架构设计.md「数据访问」
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=apphub
DB_PASSWORD=apphub@2026
DB_DATABASE=apphub

# 开发环境自动同步实体结构（仅开发便利，迁移接管后建议关闭）；
# 生产环境（NODE_ENV=production）强制关闭并告警，建表与升级走 pnpm --filter server migration:run
DB_SYNC=true

# Swagger 接口文档开关
SWAGGER_ENABLED=true

# 请求签名验证（写方法 HMAC-SHA256 校验，详见 docs/指南/请求签名验证设计.md）
# 密钥需与前端 VITE_SIGN_SECRET 一致；生产环境必须开启并替换为足够长的随机串
SIGNATURE_ENABLED=true
SIGNATURE_SECRET=change-me-to-a-long-random-string
SIGNATURE_EXPIRE_MS=300000

# 认证（JWT 签发与验签，详见 docs/指南/权限设计.md；ADR-003 无状态方案）
# 默认值为开发密钥仅供本地；生产环境必须配置独立随机串，否则服务启动 fail-fast
JWT_SECRET=dev-jwt-secret-change-me
# token 有效期（如 8h / 30m / 120s），默认 8 小时，无刷新 token
JWT_EXPIRES=8h

# 终端用户域令牌（member，与 system 域相互独立的两套信任域，详见 docs/应用管理平台/统一认证设计.md）
# 默认值为开发密钥仅供本地；生产环境必须配置独立随机串，否则服务启动 fail-fast
MEMBER_JWT_SECRET=dev-member-jwt-secret-change-me
# access token 有效期（小时），默认 8；refresh token 有效期（天），默认 30
MEMBER_ACCESS_EXPIRES_HOURS=8
MEMBER_REFRESH_EXPIRES_DAYS=30

# 新建用户的默认初始口令（批次五迁入参数表驱动）
USER_INIT_PASSWORD=admin123

# 阿里云 OSS 对象存储（应用安装包分发，详见 docs/应用管理平台/应用与版本管理设计.md §2.5）
# 安全建议：使用仅授予该桶权限的 RAM 子账号 AK；部署前提：桶 CORS 允许管理后台 Origin 的 PUT/POST/GET 与 ETag 暴露头
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# STS 直传凭证签发（RAM 角色策略仅授 packages/* PutObject；未配置时上传凭证接口返回「存储未配置」，其余功能不受影响）
STS_ROLE_ARN=
STS_SESSION_NAME=apphub-upload

# 开放 API 限流（按 AppKey + IP 滑动窗口；公开客户端阈值减半，详见 docs/应用管理平台/统一认证设计.md §3.3）
RATE_LIMIT_LIMIT=60
RATE_LIMIT_WINDOW_MS=60000

# 阿里云短信（M4 手机验证码通道，详见 docs/应用管理平台/认证方式扩展设计.md §3.2）
# AK 建议独立 RAM 子账号（仅授短信发送权限）；签名与模板需在阿里云报备审核（单通用模板，变量 code + minutes）
# 生产环境四项缺一即启动失败（fail-fast）；非生产未配置时自动降级 log 通道（验证码写服务日志）
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# SMTP 邮件通道（M4 邮箱验证码；生产环境缺配即启动失败，非生产降级 log 通道）
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# —— 在线支付渠道（M5，详见 docs/应用管理平台/在线支付渠道接入附录.md §7）——
# 按渠道独立判定：某渠道配置齐备则该渠道可用；生产两渠道全部未配（或部分填写）启动失败（fail-fast）；
# 非生产未配置 / 部分填写的渠道降级 Mock 渠道（预下单返回 mock:// 二维码串，配 mock 触发端点验收）
# 微信支付 Native：以下五项齐备视为微信渠道已配置
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=        # 商户 API 证书序列号
WECHAT_PAY_PRIVATE_KEY_PATH=   # 商户 API 私钥文件路径（apiclient_key.pem）
WECHAT_PAY_APIV3_KEY=          # APIv3 密钥（回调解密 / 平台证书下载）
# 微信支付公钥模式（可选，2024 后新商户）：两项配齐则回调验签用微信支付公钥，
# 不配则平台证书模式（验签时自动拉取平台证书，老商户）
WECHAT_PAY_PUBLIC_KEY_SERIAL=  # 微信支付公钥序列号（PUB_KEY_ID_ 开头）
WECHAT_PAY_PUBLIC_KEY_PATH=    # 微信支付公钥文件路径（wechatpayPublicKey.pem）

# 支付宝当面付：以下三项齐备视为支付宝渠道已配置
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=       # 应用私钥文件路径
ALIPAY_PUBLIC_KEY_PATH=        # 支付宝公钥文件路径（异步通知验签）
ALIPAY_GATEWAY=                # 可选；默认正式网关，沙箱联调改沙箱网关

# 回调公网地址（可选）：配置后预下单显式传 notify_url；未配置时不传——
# 微信回落商户平台默认、支付宝回落应用网关配置，兜底查单兼收
PAY_PUBLIC_BASE_URL=
