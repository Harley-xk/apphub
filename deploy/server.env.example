# apphub 生产运行配置模板：复制为 server.env 放服务器 /opt/apphub/，逐项修改标「必改」的占位值
# 主方案（发布包直部署）由 pm2 在启动 / 重启时 source 注入：source 后 pm2 restart apphub --update-env 生效；
# docker 备选方案经 compose env_file 注入，修改后 compose up -d 重建容器生效
# 配置项语义详见 server/.env.example 与 docs/指南/发布包打包与部署指南.md §8

NODE_ENV=production
PORT=3000

# ---- 数据库（外置 PostgreSQL：RDS / 自建均可） ----
DB_TYPE=postgres
# 必改：RDS 填内网连接地址（形如 pgm-xxx.pg.rds.aliyuncs.com，控制台「数据库连接」页可查）；
# 数据库与服务器同机自建填 127.0.0.1（docker 备选方案同机数据库填 host.docker.internal，compose 已映射 host-gateway）
DB_HOST=<修改为数据库内网连接地址>
DB_PORT=5432
# 必改：数据库账号
DB_USERNAME=apphub
# 必改：数据库口令
DB_PASSWORD=<修改为实际口令>
DB_DATABASE=apphub
# 保持 false：生产强制关闭，建表与升级由发布时的迁移自动执行（主方案部署脚本 / docker 备选启动脚本，ADR-005）
DB_SYNC=false

# ---- 认证（system 管理域 + member 终端域两套独立信任域，D18） ----
# 必改：长随机串，沿用开发默认值会启动失败（fail-fast 校验）
JWT_SECRET=<修改为长随机串>
JWT_EXPIRES=8h
# 必改：member 域独立密钥（终端用户令牌），沿用开发默认值同样启动失败
MEMBER_JWT_SECRET=<修改为另一长随机串>
# access token 有效期（小时）与 refresh token 有效期（天），默认 8 / 30
MEMBER_ACCESS_EXPIRES_HOURS=8
MEMBER_REFRESH_EXPIRES_DAYS=30
# 必改：种子账号 admin 的初始口令
USER_INIT_PASSWORD=<修改为种子账号初始口令>

# ---- 请求签名 ----
# 必改：须与 CI 流水线变量 VITE_SIGN_SECRET 完全一致，不一致表现为登录后所有写请求被拒
SIGNATURE_ENABLED=true
SIGNATURE_SECRET=<修改为长随机串，与前端构建密钥一致>
SIGNATURE_EXPIRE_MS=300000

# ---- 开放 API 限流（AppKey + IP 滑动窗口） ----
RATE_LIMIT_LIMIT=60
RATE_LIMIT_WINDOW_MS=60000

# ---- 全局阿里云 AccessKey（整个应用唯一一组 AK） ----
# OSS 与短信通道共用同一 RAM 子账号；子账号需同时授予 OSS 相关与短信发送（sms:SendSms）权限
ALI_ACCESS_KEY_ID=<修改为 RAM 子账号 AK>
ALI_ACCESS_KEY_SECRET=<修改为 RAM 子账号 SK>

# ---- 阿里云 OSS / STS（安装包分发，M1） ----
# 桶未配置不影响启动，上传相关接口返回「存储未配置」；上线分发安装包则必改以下各项
# AK 经上方 ALI_ACCESS_KEY_* 注入；部署前提：桶 CORS 允许管理后台 Origin 的 PUT/POST/GET 与 ETag 暴露头（见部署指南）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=<修改为实际桶名>
# STS 直传凭证签发（RAM 角色策略仅授 packages/* PutObject）
STS_ROLE_ARN=<修改为 RAM 角色 ARN>
STS_SESSION_NAME=apphub-upload

# ---- 验证码通道（M4：短信 + 邮件） ----
# 生产缺配启动 fail-fast；ALLOW_CHANNEL_FALLBACK=true 时降级 log 通道（资质窗口期，见文末开关）
# 短信 AK 经上方 ALI_ACCESS_KEY_* 注入（与 OSS 共用）；模板 SMS_512656603 变量约定：code（仅数字）+ time（仅数字 1-2 位）
SMS_SIGN_NAME=张家港智汇冰芯
SMS_TEMPLATE_CODE=SMS_512656603
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ---- 在线支付渠道（M5） ----
# 生产两渠道全未配启动 fail-fast；ALLOW_CHANNEL_FALLBACK=true 时降级（在线下单报渠道未配置，
# 线下收款备案不受影响）。某渠道配置齐备即启用该渠道；部分填写（配一半）无论开关均启动失败
# PEM 文件放服务器 /opt/apphub/pay-certs/（docker 备选方案经 compose 挂载到容器 /pay-certs）
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=/opt/apphub/pay-certs/wechat-apiclient_key.pem
WECHAT_PAY_APIV3_KEY=
# 微信公钥模式（2024 后新商户可选；不配则平台证书模式自动拉取）
WECHAT_PAY_PUBLIC_KEY_SERIAL=
WECHAT_PAY_PUBLIC_KEY_PATH=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=/opt/apphub/pay-certs/alipay-app-private-key.pem
ALIPAY_PUBLIC_KEY_PATH=/opt/apphub/pay-certs/alipay-public-key.pem
ALIPAY_GATEWAY=
# 回调公网地址：填站点完整域名（https://），配置后预下单显式传 notify_url
PAY_PUBLIC_BASE_URL=https://your-domain.example.com

# ---- 通道降级开关（上线批次 DEP-5） ----
# 资质报备未齐的上线窗口期置 true：短信/邮件降级 log 通道、支付渠道不注册；
# 资质就绪后配置真实通道并改回 false（false 为 fail-fast 默认，防呆）
ALLOW_CHANNEL_FALLBACK=true

# ---- Swagger ----
# 生产建议关闭（/api-docs 随之失效）
SWAGGER_ENABLED=false
